{
  "globs": [
    "**/*.md",
    "!.agents/**",
    "!.claude/**",
    "!.codex/**",
    "!.local/**",
    "!build/**",
    "!dist/**",
    "!node_modules/**",
    "!target/**"
  ],
  "config": {
    "default": true,
    // Prettier deliberately preserves prose wrapping, and OpenSpec evidence
    // includes long immutable command/result lines.
    "MD013": false,
    // OpenSpec artifact schemas deliberately start at level two (for example,
    // "## Why" and "## ADDED Requirements").
    "MD041": false,
    // Match Prettier's authoritative indentation for nested task-list content.
    "MD007": {
      "indent": 4
    },
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["a", "img", "p"]
    }
  }
}
